# Local Dockerfile for api-server (when building from api-server directory)

FROM python:3.11-slim

WORKDIR /app

# Copy requirements from current directory
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY src ./src

# Copy and install the core-renombrador package
COPY ../../packages/core-renombrador /app/packages/core-renombrador
RUN pip install -e /app/packages/core-renombrador

# Create non-root user
RUN adduser --system --group appuser
RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 8080

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8080"]
