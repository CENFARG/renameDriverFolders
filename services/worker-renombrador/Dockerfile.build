# services/worker-renombrador/Dockerfile.build
# This Dockerfile is used by Cloud Build from the project root

FROM python:3.11-slim

# Instalar dependencias del sistema para pdf2image (soporte OCR)
RUN apt-get update && apt-get install -y \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Crear usuario no-root primero
RUN adduser --system --group appuser

# Copiar requirements y core package
COPY packages/core-renombrador /app/packages/core-renombrador
COPY services/worker-renombrador/requirements.txt .

# Instalar todo en un solo comando para resolver dependencias correctamente
# Usar --user para instalar en el home del usuario
RUN pip install --no-cache-dir --user /app/packages/core-renombrador -r requirements.txt

# Dar ownership al usuario no-root
RUN chown -R appuser:appuser /app

# Copiar código del worker
COPY services/worker-renombrador/src ./src
COPY services/worker-renombrador/config ./config
RUN mkdir -p /app/data && chown -R appuser:appuser /app

# Switch al usuario no-root
USER appuser

EXPOSE 8080

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8080"]
